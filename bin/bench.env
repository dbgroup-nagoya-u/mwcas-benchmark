# Run benchmark over the following parameters
THREAD_CANDIDATES="1 4 8 12 16 24 28 32 40 48 56"
TARGET_CANDIDATES=$(seq 1 1 8)
SKEW_CANDIDATES=$(seq 0 0.25 2)
# lf-mwcas (A), lf-mwcas-legacy (A before fixes), lf-mwcas-rc (B), of-mwcas (C),
# of-mwcas-rc (D), lf-mwcas-weak, dlf-mwcas, casn, aopt
IMPL_CANDIDATES="lf-mwcas lf-mwcas-legacy lf-mwcas-rc"
READ_RATIO_CANDIDATES="0 0.5 0.9 0.99"

# Repeat benchmark for the following number of times
BENCH_REPEAT_COUNT="5"

# The number of MwCAS operations for each thread
ARRAY_CAPACITY="1000000"
TIMEOUT="10"
